<h2>泊位理赔证据</h2>{% if batch %}<p>泊位分钟勾稽差额 <b>{{ batch.minutes_balance }}</b></p><p>整批证据摘要 <code>{{ batch.sha256 }}</code></p><a class="download" href="/api/export/{{ key }}">下载整批理赔证据</a>{% else %}<p>先运行清算再签发。</p>{% endif %}
<h2>本车证据签发</h2>
<p>下表每辆车都是这份整批留档按车辆代号裁剪出的视图：不重跑清算、不新增留档，也不改写已签的整批证据。签发失败可直接重试，同一申诉的编号与内容不变。</p>
<p>已签整批证据仍可逐项核验：每行给出留档证据摘要与整批根摘要，下载后用同一规范化序列化算 SHA-256 即可对上。</p>
{% if claims %}<div class="tablebox"><table><thead><tr><th>车辆代号</th><th>泊位</th><th>本车分钟</th><th>争议分钟</th><th>应收</th><th>关联实收</th><th>净差</th><th>申诉</th><th>证据</th></tr></thead><tbody>{% for c in claims %}{% if c.ok %}<tr><td><code>{{ c.vehicle[:12] }}</code></td><td>{{ c.scope.berths|join('、') }}</td><td>{{ c.occupied }}</td><td>{{ c.disputed }}</td><td>{{ yuan(c.due_cents) }}</td><td>{{ yuan(c.paid_cents) }}</td><td class="{{ 'difference' if c.difference_cents else '' }}">{{ yuan(c.difference_cents) }}</td><td><code>{{ c.appeal }}</code></td><td><a href="/api/export/{{ key }}/vehicle/{{ c.vehicle }}">下载本车证据</a> · <a href="/clearing/appeal?key={{ key }}&amp;vehicle={{ c.vehicle }}">核对</a></td></tr>{% else %}<tr><td><code>{{ c.vehicle[:12] }}</code></td><td colspan="8">{{ c.message }}（{{ c.code }}）</td></tr>{% endif %}{% else %}<tr><td colspan="9">该留档没有可签发的本车停靠。</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>先运行清算再签发。</p>{% endif %}
{% if failure %}<section class="panel exceptions"><h3>签发失败</h3><p>{{ failure.message }}（{{ failure.code }}）。可原样重试，不会新增留档或证据。</p></section>{% endif %}
{% if signed %}{% set evidence=signed.evidence %}{% set money=evidence.settlement.money %}{% set rec=evidence.reconciliation %}
<section class="panel" id="signed-vehicle"><h3>本车结论 {{ signed.vehicle[:12] }} · 申诉 {{ signed.appeal }}</h3>
<dl><dt>泊位 / 时段</dt><dd>{{ evidence.scope.berths|join('、') }} · {{ local(evidence.scope.start) }} → {{ local(evidence.scope.end) }}</dd><dt>本车分钟</dt><dd>{{ rec.occupied_minutes }}，其中争议 {{ rec.disputed_minutes }}</dd><dt>应收 / 实收 / 净差</dt><dd>{{ yuan(money.due_cents) }} / {{ yuan(money.paid_cents) }} / {{ yuan(money.difference_cents) }}</dd><dt>留档编号</dt><dd><code>{{ rec.batch.key[:16] }}</code></dd><dt>本车证据摘要</dt><dd><code>{{ signed.manifest.evidence_sha256 }}</code></dd><dt>根摘要</dt><dd><code>{{ signed.sha256 }}</code></dd></dl>
<p>对账锚点：留档证据 <code>{{ rec.batch.evidence_sha256 }}</code>，整批根摘要 <code>{{ rec.batch.sha256 }}</code>。它们与已签发的整批证据完全一致，收件人可据此核实本车视图确实取自同一清算，而非另算一份。</p>
<div class="tablebox"><table><thead><tr><th>泊位</th><th>到达</th><th>离开</th><th>本车分钟</th><th>争议</th><th>实计</th><th>停靠摘要</th></tr></thead><tbody>{% for row in evidence.occupancy.stays %}{% set clock=evidence.occupancy.minutes[loop.index0] %}<tr><td>{{ row.berth }}</td><td>{{ local(row.start) }}</td><td>{{ local(row.end) }}</td><td>{{ clock.occupied }}</td><td>{{ clock.disputed }}</td><td>{{ clock.billed }}</td><td><code title="{{ rec.stay_sha256[row.stay] }}">{{ row.stay }}</code></td></tr>{% endfor %}</tbody></table></div>
<div class="tablebox"><table><thead><tr><th>泊位</th><th>本车占用</th><th>争议</th><th>首免</th><th>基础价</th><th>升级价</th></tr></thead><tbody>{% for row in evidence.settlement.berths %}<tr><td>{{ row.berth }}</td><td>{{ row.occupied }}</td><td>{{ row.disputed }}</td><td>{{ row.free }}</td><td>{{ row.base }}</td><td>{{ row.upgrade }}</td></tr>{% endfor %}</tbody></table></div>
<div class="tablebox"><table><thead><tr><th>泊位 / 到达</th><th>应收</th><th>实收</th><th>差价</th><th>回执</th><th>结论</th></tr></thead><tbody>{% for row in evidence.settlement.lines %}<tr><td>{{ local(row.arrival) }} · {{ row.berth }}</td><td>{{ yuan(row.due_cents) }}</td><td>{{ yuan(row.paid_cents) }}</td><td class="{{ 'difference' if row.difference_cents else '' }}">{{ yuan(row.difference_cents) }}</td><td>{% for r in row.receipts %}{{ r.fields.receipt }} · 第 {{ r.line }} 行{% if not loop.last %} / {% endif %}{% else %}—{% endfor %}</td><td>{{ label[row.code] }}</td></tr>{% endfor %}</tbody></table></div>
<section class="panel exceptions"><h3>争议分钟凭据</h3><div class="tablebox"><table><thead><tr><th>泊位</th><th>分钟</th><th>原因</th><th>停靠</th></tr></thead><tbody>{% for row in evidence.occupancy.disputes %}<tr><td>{{ row.berth }}</td><td>{{ local(row.at) }}</td><td>{{ label[row.code] }}</td><td><code>{{ row.stay }}</code></td></tr>{% else %}<tr><td colspan="4">本车无争议分钟。</td></tr>{% endfor %}</tbody></table></div><h3>重叠对账</h3><div class="tablebox"><table><thead><tr><th>泊位</th><th>区间</th><th>分钟</th><th>原因</th><th>重叠方</th><th>记录摘要</th></tr></thead><tbody>{% for row in evidence.occupancy.counterparts %}<tr><td>{{ row.berth }}</td><td>{{ local(row.start) }} → {{ local(row.end) }}</td><td>{{ row.minutes }}</td><td>{{ label[row.code] }}</td><td>{{ '本车同时在 ' ~ row.counterpart_berth if row.same_vehicle else '同泊位他车' }}{% if row.same_vehicle %} · <code>{{ row.stay }}</code>{% endif %}</td><td><code title="{{ row.record_sha256 }}">{{ row.record_sha256[:16] }}</code></td></tr>{% else %}<tr><td colspan="6">无重叠。</td></tr>{% endfor %}</tbody></table></div><p>争议分钟逐分钟列明，合计即本车争议时长，与停靠分段中的免计分钟一一对应。同车跨泊位的重叠方是本车在另一泊位的停靠，摘要与上表停靠摘要一致；同泊位他车只披露整条记录摘要，不含车牌或其他明细。</p></section>
<a class="download" href="/api/export/{{ key }}/vehicle/{{ signed.vehicle }}">下载本车证据</a>
{% endif %}
